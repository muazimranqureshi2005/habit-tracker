# Copy this file to `.env` and fill in real values. `.env` is ignored by Git.
# On Vercel you type these same two keys into Project Settings -> Environment Variables.

# 1) Neon connection string (Neon dashboard -> Connect -> copy the "Pooled connection" string)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/dbname?sslmode=require

# 2) A long random string used to sign login cookies. Generate one with:
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Local development port (Vercel ignores this)
PORT=3000
